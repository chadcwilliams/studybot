# Get a free key at https://console.groq.com (no credit card required)
GROQ_API_KEY=your-groq-api-key-here

# Comma-separated list of origins allowed to call this API
# (your GitHub Pages URL, plus http://localhost for local dev)
ALLOWED_ORIGINS=http://localhost:8000,https://yourname.github.io

# Optional overrides — sensible defaults are set in config.py
# GROQ_MODEL=openai/gpt-oss-20b   # or openai/gpt-oss-120b for higher quality, slower/lower quota
# COURSE_NAME=Psyc 351D - Biopsychology   # set per Render service when running multiple courses
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=4
